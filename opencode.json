{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "worker": {
      "description": "Text-only code writer driven by Claude via .claude/tools/ar.mjs",
      "mode": "primary",
      "model": "agentrouter/gpt-6.1-sol",
      "tools": {
        "*": false
      },
      "permission": {
        "*": "deny"
      }
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "openai/gpt-6.1-sol": {
          "name": "OpenAI: GPT-6.1 Sol",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    },
    "agentrouter": {
      "npm": "@ai-sdk/openai",
      "name": "Agent Router",
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    }
  }
}
